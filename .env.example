# Copy this file to .env (or enter these in your hosting platform's environment
# settings) and fill in the real values. .env is git-ignored, so passwords and
# personal addresses never end up in the repository.
#
# Without SMTP_HOST the site still works: requests are saved on the server
# (the contact-data volume, file requests.jsonl) but not emailed.

# Where contact form requests are delivered. Use the real inbox (e.g. your Gmail
# address) rather than a Cloudflare-routed alias: Gmail tends to hide messages
# it sends to itself through a forwarding address.
MAIL_TO=your-address@gmail.com

# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it as SMTP_PASS
# (without spaces). MAIL_FROM must be the same Gmail address.
MAIL_FROM=your-address@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-16-letter-app-password
